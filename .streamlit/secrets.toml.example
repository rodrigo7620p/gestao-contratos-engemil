# Copie este arquivo para .streamlit/secrets.toml (uso local) e preencha com
# os valores reais do seu banco Turso. Em produção (Streamlit Community
# Cloud), esses mesmos dois valores vão em "Settings > Secrets" do app —
# não em um arquivo.
#
# Sem essas duas linhas o sistema usa o arquivo SQLite local
# (gestao_contratos.db), o que é o comportamento padrão em desenvolvimento.

TURSO_DATABASE_URL = "libsql://SEU-BANCO-SUAORG.turso.io"
TURSO_AUTH_TOKEN = "seu-token-aqui"
